# NoryxBot Presence settings. Copy this file to .env and fill it in.
# .env is ignored by Git: never commit it.

# Discord Developer Portal → "NoryxBot Presence" application → Bot → Reset Token.
# In the same Bot tab, turn on "Server Members Intent" and "Presence Intent".
PRESENCE_BOT_TOKEN=

# Servers where joining turns tracking on (default: NoryxBot's and Studio Zératik's)
PRESENCE_GUILD_IDS=1556972010754678807,1463195333692752010

# Web server (API on /v1, live socket on /socket). Behind a reverse proxy, keep 127.0.0.1.
PORT=3007
HOST=127.0.0.1

# debug, info, warn or error
LOG_LEVEL=info
