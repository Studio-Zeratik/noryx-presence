{
  "name": "noryx-presence",
  "version": "0.1.0",
  "private": true,
  "description": "NoryxBot Presence: your live Discord status on your website, GitHub profile or stream. Public API, real-time socket, embeddable cards, OBS overlay and social banner.",
  "keywords": [
    "discord",
    "discord-presence",
    "presence",
    "spotify",
    "obs-overlay",
    "github-profile",
    "api",
    "websocket"
  ],
  "homepage": "https://noryxbot.com/presence/",
  "bugs": {
    "url": "https://github.com/Studio-Zeratik/noryx-presence/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studio-Zeratik/noryx-presence.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Studio Zératik inc. <contact@noryxbot.com> (https://studiozeratik.com)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.28.1",
    "hono": "^4.13.17",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
